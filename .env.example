# Copy to .env and fill in. Never commit .env.
# Leave ANTHROPIC_API_KEY empty if you use `ant auth login` (the SDK picks up the profile).
ANTHROPIC_API_KEY=

DSAGENT_LLM_PROVIDER=anthropic
DSAGENT_LLM_MODEL_PLANNER=claude-opus-5-5
DSAGENT_LLM_MODEL_CHEAP=claude-haiku-5-5

# Per-run budgets (a run stops with a report when one is exceeded)
DSAGENT_MAX_TOKENS_PER_RUN=500000
DSAGENT_MAX_COST_PER_RUN=2.00
DSAGENT_MAX_PAGES_PER_RUN=200

DSAGENT_CACHE_DB_PATH=.cache/llm_cache.sqlite
DSAGENT_SOURCE_ALLOWLIST_PATH=configs/allowlist.txt
DSAGENT_USER_AGENT=dsagent-research-bot/0.1 (academic project)
