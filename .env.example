# Copy to .env and fill in. Never commit .env (it is git-ignored).

# --- LLM provider -------------------------------------------------------
# openrouter (default, cheapest for development) or anthropic
DSAGENT_LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=

# Models (OpenRouter IDs). Rationale and alternatives: docs/MODEL_CHOICE.md
DSAGENT_LLM_MODEL_PLANNER=meta/muse-ember
DSAGENT_LLM_MODEL_CHEAP=openai/gpt-6-luna

# Only needed when DSAGENT_LLM_PROVIDER=anthropic
# (then use model IDs like claude-opus-5-5 / claude-haiku-5-5)
ANTHROPIC_API_KEY=

# --- Per-run budgets (a run stops with a report when one is exceeded) ---
DSAGENT_MAX_TOKENS_PER_RUN=500000
DSAGENT_MAX_COST_PER_RUN=0.25
DSAGENT_MAX_PAGES_PER_RUN=200

DSAGENT_CACHE_DB_PATH=.cache/llm_cache.sqlite
DSAGENT_SOURCE_ALLOWLIST_PATH=configs/allowlist.txt
DSAGENT_USER_AGENT=dsagent-research-bot/0.1 (academic project)
